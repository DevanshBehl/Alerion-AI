# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=alerion-backend

# WebSocket Server
WS_PORT=8080

# Express Health Server
HTTP_PORT=3000

# ML Service (Python Flask)
ML_SERVICE_URL=http://localhost:5000

# Set to "true" to use TypeScript mock predictions instead of Python ML service
USE_MOCK_ML=false

# Kafka Topics
MACHINE_DATA_TOPIC=machine-data
PREDICTION_DATA_TOPIC=prediction-data

# MongoDB
MONGODB_URI=mongodb://localhost:27017/alerion

# JWT
JWT_SECRET=alerion-dev-secret-change-in-production
JWT_EXPIRES_IN=7d
